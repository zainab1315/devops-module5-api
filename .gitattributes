# Normalise line endings so shell scripts work on Linux runners
* text=auto eol=lf

*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

*.sh      text eol=lf
Dockerfile text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.md      text eol=lf

# Treat these as binary
*.png     binary
*.jpg     binary
*.gif     binary
*.ico     binary
*.lock    -diff
package-lock.json -diff
